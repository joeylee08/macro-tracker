generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  meals Meal[]

  @@map("users")
}

model Food {
  id              Int              @id @default(autoincrement())
  name            String
  mealIngredients MealIngredient[]

  @@map("foods")
}

model MealIngredient {
  mealId Int   @map("meal_id")
  foodId Int   @map("food_id")
  units  Float

  food Food @relation(fields: [foodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  meal Meal @relation(fields: [mealId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([mealId, foodId])
  @@map("meal_ingredients")
}

model Meal {
  id              Int              @id @default(autoincrement())
  name            String
  userId          Int              @map("user_id")
  mealIngredients MealIngredient[]
  user            User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("meals")
}