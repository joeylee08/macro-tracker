{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "types": [
      "node"
    ],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },

  "include": ["src"]
}